<%- include('../layouts/header', {
    title: 'Checkout | CarryHub'
}) %>

<%- include('../layouts/navbar', { user: user }) %>

<section class="checkout-page section-padding">

    <div class="container-custom">

        <div class="cart-hero mb-5">

            <span class="hero-badge">
                Final step before placing your order
            </span>

            <h1 class="section-title mb-2">
                Checkout
            </h1>

            <p class="cart-summary-copy">
                Confirm your shipping details and review your order.
            </p>

        </div>

        <div class="checkout-form-wrapper">

            <div class="row g-4">

                <!-- SHIPPING DETAILS -->

                <div class="col-lg-8">

                    <div class="checkout-card">

                        <h2
                            class="checkout-card-title"
                            style="color: var(--secondary-color)"
                        >
                            Shipping Information
                        </h2>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Full Name
                                </label>

                                <input
                                    type="text"
                                    name="full_name"
                                    class="form-control"
                                    value="<%= user.full_name %>"
                                    readonly
                                >

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    Phone Number
                                </label>

                                <input
                                    type="text"
                                    name="phone"
                                    class="form-control"
                                    value="<%= user.phone || '' %>"
                                    required
                                >

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    Region
                                </label>

                                <input
                                    type="text"
                                    name="region"
                                    class="form-control"
                                    required
                                >

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    District
                                </label>

                                <input
                                    type="text"
                                    name="district"
                                    class="form-control"
                                    required
                                >

                            </div>

                            <div class="col-12">

                                <label class="form-label">
                                    Street Address
                                </label>

                                <textarea
                                    name="address"
                                    rows="4"
                                    class="form-control"
                                    required
                                ></textarea>

                            </div>

                            <div class="col-12">

                                <label class="form-label">
                                    Additional Notes
                                </label>

                                <textarea
                                    name="notes"
                                    rows="3"
                                    class="form-control"
                                ></textarea>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ORDER SUMMARY -->

                <div class="col-lg-4">

                    <aside class="cart-summary-card">

                        <h2
                            class="cart-summary-title text-center"
                            style="color: var(--secondary-color)"
                        >
                            ORDER SUMMARY
                        </h2>

                        <% items.forEach(item => { %>

                            <div class="checkout-item">

                                <span>
                                    <%= item.name %>
                                    × <%= item.quantity %>
                                </span>

                                <strong>
                                    TZS
                                    <%= Number(item.line_total).toLocaleString() %>
                                </strong>

                            </div>

                        <% }) %>

                        <hr>

                        <div class="cart-summary-row">

                            <span>
                                Subtotal
                            </span>

                            <strong>
                                TZS
                                <%= Number(cartSubtotal).toLocaleString() %>
                            </strong>

                        </div>

                        <div class="cart-summary-row">

                            <span>
                                Delivery
                            </span>

                            <strong>
                                Free
                            </strong>

                        </div>

                        <div class="cart-summary-row total-row">

                            <span>
                                <strong style="color: var(--secondary-color)">
                                    Total
                                </strong>
                            </span>

                            <strong style="color: var(--secondary-color)">
                                TZS
                                <%= Number(cartSubtotal).toLocaleString() %>
                            </strong>

                        </div>

                        <hr>

                        <p
                            class="text-center mb-3"
                            style="font-size: 0.95rem;"
                        >
                            Secure payment powered by PayPal
                        </p>

                        <div
                            id="paypal-button-container"
                            class="mt-3"
                        ></div>

                    </aside>

                </div>

            </div>

        </div>

    </div>

</section>

<script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=USD"></script>

<script>

paypal.Buttons({

    createOrder() {

        const region =
            document.querySelector(
                '[name="region"]'
            ).value.trim();

        const district =
            document.querySelector(
                '[name="district"]'
            ).value.trim();

        const address =
            document.querySelector(
                '[name="address"]'
            ).value.trim();

        if (
            !region ||
            !district ||
            !address
        ) {

            alert(
                'Please complete all shipping information first.'
            );

            return;
        }

        return fetch(
            '/api/paypal/create-order',
            {
                method: 'POST'
            }
        )
        .then(response => response.json())
        .then(data => data.id);

    },

    onApprove(data) {

        return fetch(
            '/api/paypal/capture-order',
            {
                method: 'POST',

                headers: {
                    'Content-Type':
                        'application/json'
                },

                body: JSON.stringify({

                    paypalOrderId:
                        data.orderID,

                    region:
                        document.querySelector(
                            '[name="region"]'
                        ).value,

                    district:
                        document.querySelector(
                            '[name="district"]'
                        ).value,

                    address:
                        document.querySelector(
                            '[name="address"]'
                        ).value,

                    phone:
                        document.querySelector(
                            '[name="phone"]'
                        ).value,

                    notes:
                        document.querySelector(
                            '[name="notes"]'
                        ).value

                })

            }
        )
        .then(response => response.json())
        .then(data => {

            if (data.success) {

                window.location.href =
                    `/order-success/${data.orderId}`;

            } else {

                alert(
                    data.message ||
                    'Payment processing failed'
                );

            }

        });

    },

    onError(error) {

        console.error(error);

        alert(
            'PayPal payment failed. Please try again.'
        );

    }

})
.render('#paypal-button-container');

</script>

<%- include('../layouts/footer') %>
<%- include('../layouts/scripts') %>