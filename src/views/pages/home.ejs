<%- include('../layouts/header', {
    title: 'CarryHub | Home'
}) %>

<%- include('../layouts/navbar', { user: user }) %>

<!-- HERO SECTION -->
<section class="hero-section">

    <div class="container-custom">

        <div class="row align-items-center g-5">

            <div class="col-lg-6 order-lg-1 order-2">

                <span class="hero-badge">
                    Premium Bags Collection
                </span>

                <h1 class="hero-title">
                    Carry Style,
                    <span>Carry Confidence.</span>
                </h1>

                <p class="hero-description">
                    Discover premium backpacks, laptop bags,
                    travel bags and everyday essentials crafted
                    for comfort, durability and timeless style.
                </p>

                <div class="hero-buttons">

                    <a href="/products"
                       class="btn btn-carryhub">
                        Shop Now <i class="bi bi-arrow-right"></i>
                    </a>

                    <a href="/cart"
                       class="btn btn-outline-carryhub">
                        Your Cart <i class="bi bi-cart"></i>
                    </a>

                </div>

                <div class="hero-features">

                    <div class="hero-feature">
                        ✓ Premium Quality
                    </div>

                    <div class="hero-feature">
                        ✓ Fast Delivery
                    </div>

                    <div class="hero-feature">
                        ✓ Secure Checkout
                    </div>

                </div>

            </div>

            <div class="col-lg-6 order-lg-2 order-1">

                <div class="hero-image-container">

                    <div class="hero-image-bg"></div>

                    <img
                        src="/images/hero_image.png"
                        alt="CarryHub Bags"
                        class="hero-image"
                    >

                </div>

            </div>

        </div>

    </div>

</section><%- include('../layouts/footer') %>
<%- include('../layouts/scripts') %>