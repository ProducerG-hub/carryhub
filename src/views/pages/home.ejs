<%- include('../layouts/header', {
    title: 'CarryHub | Home'
}) %>

<%- include('../layouts/navbar', { user: user }) %>

<!-- HERO SECTION -->
<section class="hero-section">

    <div class="container-custom">

        <div class="row align-items-center">

            <!-- Hero Content -->
            <div class="col-lg-6">

                <span class="hero-badge">
                    Premium Bags Collection
                </span>

                <h1 class="hero-title">
                    Carry Style,
                    Carry Confidence.
                </h1>

                <p class="hero-description">
                    Discover premium backpacks, travel bags,
                    laptop bags and everyday essentials
                    designed for comfort, durability and style.
                </p>

                <div class="hero-buttons">

                    <a href="/products"
                       class="btn btn-carryhub">
                        Shop Now 
                        <i class="bi bi-arrow-right">
                        </i>
                    </a>

                    <a href="/categories"
                       class="btn btn-outline-carryhub">
                        Browse Categories
                    </a>

                </div>

            </div>

            <!-- Hero Image -->
            <div class="col-lg-6">

                <div class="hero-image-wrapper">

                    <img
                        src="/images/hero_image.png"
                        alt="CarryHub Premium Bag"
                        class="hero-image"
                    >

                </div>

            </div>

        </div>

    </div>

</section>
<%- include('../layouts/footer') %>
<%- include('../layouts/scripts') %>