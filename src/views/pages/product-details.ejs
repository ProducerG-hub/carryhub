<%- include('../layouts/header', {
    title: product.name + ' | CarryHub'
}) %>

<%- include('../layouts/navbar') %>

<section class="product-details-page section-padding">

    <div class="container-custom">

        <div class="row g-5 align-items-center">

            <!-- Product Image -->

            <div class="col-lg-6">

                <div class="product-details-image">

                    <img
                        src="<%= product.image_url || '/images/products/default.png' %>"
                        alt="<%= product.name %>"
                        onerror="this.onerror=null;this.src='/images/products/default.png';"
                        class="img-fluid"
                    >

                </div>

            </div>

            <!-- Product Info -->

            <div class="col-lg-6">

                <span class="product-category">

                    <%= product.category %>

                </span>

                <h1 class="product-title">

                    <%= product.name %>

                </h1>

                <div class="product-rating">

                    ★★★★★

                </div>

                <div class="product-price">

                    TZS
                    <%= Number(product.price).toLocaleString() %>

                </div>

                <p class="product-description">

                    <%= product.description %>

                </p>

                <div class="product-stock">

                    <% if(product.stock_quantity > 0) { %>

                        <span class="in-stock">

                            In Stock

                        </span>

                    <% } else { %>

                        <span class="out-stock">

                            Out Of Stock

                        </span>

                    <% } %>

                </div>

                <form action="/api/cart/add/<%= product.product_id %>" method="POST" class="product-actions">
                    <input type="hidden" name="next" value="/products/<%= product.product_id %>">

                    <div class="quantity-wrapper mb-4">
                        <label for="quantityInput">

                            Quantity

                        </label>

                        <input
                            id="quantityInput"
                            name="quantity"
                            type="number"
                            min="1"
                            value="1"
                            class="form-control quantity-input"
                        >

                    </div>

                    <button
                        type="submit"
                        class="btn btn-carryhub btn-lg"
                    >
                        Add To Cart
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>

<%- include('../layouts/footer') %>
<%- include('../layouts/scripts') %>