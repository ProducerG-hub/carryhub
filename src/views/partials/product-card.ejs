<div class="product-card">

    <div class="product-image-wrapper">

        <a href="/products/<%= product.product_id %>">

            <img
                src="<%= product.image_url || '/images/products/default.png' %>"
                alt="<%= product.name %>"
                onerror="this.onerror=null;this.src='/images/products/default.png';"
                class="product-image"
            >

        </a>

    </div>

    <div class="product-content">

        <h5 class="product-name">

            <a
                href="/products/<%= product.product_id %>"
                class="product-link"
            >
                <%= product.name %>
            </a>

        </h5>



        <div class="product-rating">
            ★★★★★
        </div>

        <div class="product-price">
            Tsh. <%= Number(product.price).toLocaleString() %>
        </div>

        <form action="/api/cart/add/<%= product.product_id %>" method="POST" class="m-0">
            <input type="hidden" name="next" value="/products">

            <button
                type="submit"
                class="btn btn-carryhub w-100"
            >
                Add to Cart
            </button>
        </form>

    </div>

</div>