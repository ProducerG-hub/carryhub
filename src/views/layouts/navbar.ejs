<!-- ==========================
     DESKTOP NAVBAR
========================== -->
<nav class="desktop-navbar carryhub-navbar sticky-top">

    <div class="container-custom">

        <a class="navbar-brand" href="/">
            <img
                src="/images/carryhub.png"
                alt="CarryHub Logo"
                height="55"
            >
        </a>

        <ul class="desktop-nav-links">

            <li>
                <a href="/">Home</a>
            </li>

            <li>
                <a href="/products">Shop</a>
            </li>

            <li>
                <a href="/contact">Contact</a>
            </li>

        </ul>

        <div class="desktop-right">

            <form class="desktop-search">
                <input
                    type="search"
                    class="form-control"
                    placeholder="Search bags..."
                >
            </form>

            <% if (user) { %>
                <div class="dropdown nav-user-dropdown">
                    <button
                        class="btn nav-user-toggle dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <span class="nav-user-avatar">
                            <%= user.full_name.charAt(0).toUpperCase() %>
                        </span>
                        <span class="nav-user-name"><%= user.full_name %></span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end nav-user-menu">
                        <li>
                            <a class="dropdown-item" href="/profile">My profile</a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <form action="/api/auth/logout" method="POST" class="m-0">
                                <button type="submit" class="dropdown-item text-danger">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            <% } else { %>
                <a href="/login" class="nav-action">
                    Sign In
                </a>

                <a href="/register" class="nav-action">
                    Sign Up
                </a>
            <% } %>

            <a href="/cart" class="cart-link">
                🛒
                <span class="cart-badge">0</span>
            </a>

        </div>

    </div>

</nav>


<!-- ==========================
     MOBILE NAVBAR
========================== -->

<nav class="mobile-navbar sticky-top">

    <div class="container-custom">

        <!-- Row 1 -->
        <div class="mobile-top-bar">

            <a class="navbar-brand" href="/">
                <img
                    src="/images/carryhub.png"
                    alt="CarryHub Logo"
                    height="45"
                >
            </a>

            <form class="mobile-search">

                <input
                    type="search"
                    class="form-control"
                    placeholder="Search bags..."
                >

            </form>

        </div>

        <!-- Row 2 -->

        <div class="mobile-nav-links">

            <a href="/">
                 Home
            </a>

            <a href="/products">
                 Shop
            </a>

            <% if (user) { %>
                <div class="dropdown nav-user-dropdown mobile-user-dropdown">
                    <button
                        class="btn nav-user-toggle dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <span class="nav-user-avatar">
                            <%= user.full_name.charAt(0).toUpperCase() %>
                        </span>
                        <span class="nav-user-name"><%= user.full_name.split(' ')[0] %></span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end nav-user-menu">
                        <li>
                            <a class="dropdown-item" href="/profile">My profile</a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <form action="/api/auth/logout" method="POST" class="m-0">
                                <button type="submit" class="dropdown-item text-danger">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            <% } else { %>
                <a href="/login">
                    Sign In
                </a>

                <a href="/register">
                    Sign Up
                </a>
            <% } %>

            <a href="/cart" class="mobile-cart">

                🛒 Cart

                <span class="cart-badge">
                    0
                </span>

            </a>

        </div>

    </div>

</nav>